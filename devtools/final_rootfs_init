#!/bin/sh

# 1. Mount essential filesystems
mkdir -p /proc /sys /dev /dev/pts
mount -t proc none /proc
mount -t sysfs none /sys
mount -t devtmpfs none /dev 2>/dev/null || true
mount -t devpts none /dev/pts 2>/dev/null || true

# 2. The God-Mode Debug Hack: Route all script stdout/stderr to the kernel log!
# This bypasses the TTY entirely for our debug echoes. 
# They will print via the bare-metal 'earlycon' panic logger.
exec >/dev/kmsg 2>&1

echo "===================================================="
echo "   [CCD SERIAL BOOT] FINAL TARGET KERNEL REACHED    "
echo "===================================================="
echo "[*] System identity: $(hostname 2>/dev/null || echo "headless-stoney")"
echo "[*] Essential filesystems mounted successfully."

# 3. Setup Environment
export PATH="/bin:/sbin:/usr/bin:/usr/sbin"
export HOME="/"
export TERM="linux"
export PS1="Final-Serial# "

echo "[*] Bypassing Carrier Detect and forcing serial pipe open..."

# 4. Launch the shell using GETTY!
# getty is specifically designed to handle serial lines properly.
# -L: Local line (forces the kernel to ignore the missing DCD carrier pin)
# -n: Do not prompt for login (we want root immediately)
# -l: Specify the exact program to spawn (our shell)
while true; do
    setsid getty -L -n -l /bin/sh 115200 /dev/ttyS0 vt100
    
    # If getty fails (e.g. ttyS0 doesn't exist), this will print to the kernel log!
    echo "[-] FATAL: getty exited or crashed. Restarting in 1 second..."
    sleep 1
done