#!/bin/sh

# 1. Mount essential filesystems
mkdir -p /proc /sys /dev /tmp /run /mnt/testing
mount -t proc none /proc
mount -t sysfs none /sys
mount -t devtmpfs none /dev 2>/dev/null || true

echo "===================================================="
echo "  [NETWORK BOOT] LAUNCHING HEADLESS DIAGNOSTIC INIT  "
echo "===================================================="

# --- PHASE 1: PARSE KERNEL COMMAND LINE ---
CMDLINE=$(cat /proc/cmdline)
WIFI_SSID=""
WIFI_PASS=""
TARGET_IP=""

for arg in $CMDLINE; do
    case "$arg" in
        wifi_ssid=*)
            WIFI_SSID="${arg#wifi_ssid=}"
            ;;
        wifi_pass=*)
            WIFI_PASS="${arg#wifi_pass=}"
            ;;
        target_ip=*)
            TARGET_IP="${arg#target_ip=}"
            ;;
    esac
done

# --- PHASE 2: HARDWARE IDENTITY CONFIGURATION ---
echo "[*] Configuring hardware network identity..."

# Set a custom system hostname
hostname "headless-stoney"

# Bring down the interface to spoof the MAC address
if [ -d /sys/class/net/wlan0 ]; then
    ip link set dev wlan0 down 2>/dev/null || ifconfig wlan0 down 2>/dev/null
    
    # Set a custom MAC address (adjust the placeholder hex values as desired)
    ip link set dev wlan0 address 00:11:22:33:44:55 2>/dev/null || ifconfig wlan0 hw ether 00:11:22:33:44:55 2>/dev/null
    
    ip link set dev wlan0 up 2>/dev/null || ifconfig wlan0 up 2>/dev/null
    echo "[+] Hardware identity configured successfully."
else
    echo "[-] Error: Wireless interface wlan0 not detected!"
fi

# --- PHASE 3: ESTABLISH WIRELESS CONNECTION ---
if [ -n "$WIFI_SSID" ] && [ -n "$WIFI_PASS" ]; then
    echo "[*] Generating wireless configuration for SSID: $WIFI_SSID"
    
    # Generate standard wpa_supplicant file on the fly in volatile storage
    mkdir -p /etc/wpa_supplicant
    cat << EOF > /tmp/wpa_supplicant.conf
ctrl_interface=/var/run/wpa_supplicant
update_config=1
network={
    ssid="$WIFI_SSID"
    psk="$WIFI_PASS"
}
EOF

    echo "[*] Launching wpa_supplicant background daemon..."
    wpa_supplicant -B -i wlan0 -c /tmp/wpa_supplicant.conf -f /tmp/wpa_supplicant.log

    echo "[*] Requesting IP address from DHCP lease server..."
    udhcpc -i wlan0 -n -q -T 5 -t 3
else
    echo "[!] Warning: Wi-Fi credentials missing from kernel command line parameters."
fi

# --- PHASE 4: REMOTE TELEMETRY DEPLOYMENT ---
# Check if we successfully obtained a network route
if ip route | grep -q wlan0 || route -n | grep -q wlan0; then
    echo "[+] Network connection established successfully!"
    
    # OPTION A: Stream live kernel panic logs to a remote listener machine
    if [ -n "$TARGET_IP" ]; then
        echo "[*] Initializing remote kernel log stream to $TARGET_IP..."
        # Continuously transmit dmesg logs to your development machine's netcat listener
        (
            while true; do
                dmesg | nc "$TARGET_IP" 9001
                sleep 2
            done
        ) &
    fi

    # OPTION B: Open a stable interactive console session using BusyBox telnetd
    echo "[*] Initializing local terminal shell service on port 23..."
    # Starts BusyBox login console without requiring a password for quick local development
    telnetd -l /bin/sh -p 23
    
    # Sit in a safe hold loop keeping the environment active for your connection
    while true; do
        sleep 5
    done
else
    echo "[-] Network deployment failed. Falling back to storage loop configuration."
    sleep 30
    echo 1 > /proc/sys/kernel/sysrq
    echo b > /proc/sysrq-trigger
fi