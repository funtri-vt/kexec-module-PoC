#!/bin/sh

# 1. Mount essential filesystems
mkdir -p /proc /sys /dev /mnt
mount -t proc none /proc
mount -t sysfs none /sys
mount -t devtmpfs none /dev 2>/dev/null || true

mkdir /mnt/testing
mount -t ext4 /dev/sda4 /mnt/testing
sleep 5
echo "========================================" >> /mnt/testing/kexec_success.log
echo "SUCCESS: Final kernel reached on $(date)" >> /mnt/testing/kexec_success.log
echo "========================================" >> /mnt/testing/kexec_success.log

sleep 3
sync

sleep 3
dmesg > /mnt/testing/kexec_success_dmesg.log

sleep 3
sync
umount /mnt/testing
sleep 1
echo 1 > /proc/sys/kernel/sysrq
echo s > /proc/sysrq-trigger
echo b > /proc/sysrq-trigger

# --- DYNAMIC HARDWARE BINDING ---
# Parse the relayed command line to find the exact hardware port we booted with
CMDLINE=$(cat /proc/cmdline)
TARGET_TTY="ttyS0" # Fallback if missing
for arg in $CMDLINE; do
    case "$arg" in
        target_console=*)
            RAW_TTY="${arg#target_console=}"
            # Strip baud rate from string if present (e.g. ttyS0,115200 -> ttyS0)
            TARGET_TTY=$(echo "$RAW_TTY" | cut -d, -f1)
            ;;
    esac
done
TARGET_DEV="/dev/$TARGET_TTY"

# 2. Print a welcome message to the kernel log
echo "==========================================" > /dev/kmsg
echo "   WELCOME TO THE FINAL SHELL" > /dev/kmsg
echo "   SPAWNING DIRECT CONSOLE ON $TARGET_DEV..." > /dev/kmsg
echo "==========================================" > /dev/kmsg

# 3. Setup Environment
export PATH="/bin:/sbin:/usr/bin:/usr/sbin"
export HOME="/"
export TERM="linux"
export PS1="Final Shell# "

# 4. Clear any stale serial line settings to ensure clean input/output
stty -F $TARGET_DEV clocal sane 2>/dev/null || true

# 5. Launch the shell!
# We attempt cttyhack first as it establishes a true controlling terminal.
# We bind explicitly to the dynamically detected hardware device.
echo ""
echo "=========================================="
echo "   WELCOME TO THE FINAL SHELL"
echo "=========================================="
echo ""

exec setsid cttyhack /bin/sh || exec sh -i <$TARGET_DEV >$TARGET_DEV 2>&1
