#!/bin/sh

# 1. Mount essential filesystems
mkdir -p /proc /sys /dev /dev/pts
mount -t proc none /proc
mount -t sysfs none /sys
mount -t devtmpfs none /dev 2>/dev/null || true
mount -t devpts none /dev/pts 2>/dev/null || true

echo "===================================================="
echo "   [CCD SERIAL BOOT] FINAL TARGET KERNEL REACHED    "
echo "===================================================="
echo "[*] System identity: $(hostname 2>/dev/null || echo "headless-stoney")"
echo "[*] Direct serial console active. Ready for live debugging."

# 2. Setup Environment
export PATH="/bin:/sbin:/usr/bin:/usr/sbin"
export HOME="/"
export TERM="linux"
export PS1="Final-Serial# "

# 3. Clear any stale serial line settings to ensure clean input/output
stty -F /dev/ttyS0 clocal sane 2>/dev/null || true

# 4. Launch the shell!
# We attempt cttyhack first as it establishes a true controlling terminal.
# We bind explicitly to the serial hardware device.
echo ""
echo "===================================================="
echo "   WELCOME TO THE LIVE DIAGNOSTIC SERIAL SHELL"
echo "===================================================="
echo ""

while true; do
    setsid /bin/sh -c 'exec /bin/sh </dev/console >/dev/console 2>&1'
    echo "Shell exited/dropped, respawning..."
    sleep 1
done