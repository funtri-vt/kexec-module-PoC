#!/bin/sh

mkdir -p /proc /sys /dev /dev/pts
mount -t proc none /proc
mount -t sysfs none /sys
mount -t devtmpfs none /dev 2>/dev/null || true
mount -t devpts none /dev/pts 2>/dev/null || true

# Send early init messages to the kernel log
echo "[*] Mounting filesystems..." > /dev/kmsg

export PATH="/bin:/sbin:/usr/bin:/usr/sbin"
export TERM="vt100"
export PS1="Final-Serial# "

echo "[*] NATIVE DRIVER HACK ACTIVE. Launching getty on /dev/console..." > /dev/kmsg

# The immortal PID 1 loop
while true; do
    # We know ttyS0 is alive now, so we bind directly to it!
    # 115200 baud, bypassing /dev/console magic.
    setsid getty -L -n -l /bin/sh 115200 /dev/ttyS0 vt100
    
    # If we get here, the shell exited
    echo "Shell exited! Retrying in 3 seconds..." > /dev/kmsg
    sleep 3
done
