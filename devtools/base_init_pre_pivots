#!/bin/sh

# 1. Create mount points and mount essential filesystems
mkdir -p /proc /sys /dev
mount -t proc none /proc
mount -t sysfs none /sys

# devtmpfs might fail if the locked-down host kernel lacks support, 
# but we ignore the error because we will manually create our node anyway!
mount -t devtmpfs none /dev 2>/dev/null || true

echo "[*] Loading kexec module..." > /dev/kmsg

# DYNAMIC VERIFICATION: Hash of the file physically present in the running initramfs
echo "==========================================================" > /dev/kmsg
echo " [*] DYNAMIC VERIFICATION: ACTIVE RAMDISK FILE HASH" > /dev/kmsg
echo "==========================================================" > /dev/kmsg
sha256sum /lib/kexec_mod.ko > /dev/kmsg 2>&1
echo "==========================================================" > /dev/kmsg

# Redirect all loader output (stdout and stderr) to the kernel log
/bin/finit_loader /lib/kexec_mod.ko > /dev/kmsg 2>&1
LOAD_RET=$?
echo "[*] finit_loader exit code: $LOAD_RET" > /dev/kmsg

echo "[*] Extracting hidden kernel logs (dmesg):" > /dev/kmsg
dmesg | grep kexec > /dev/kmsg

echo "[*] Checking /proc/modules to verify memory residency:" > /dev/kmsg
grep kexec /proc/modules > /dev/kmsg || echo "[-] Module NOT found in /proc/modules!" > /dev/kmsg

echo "[*] Dumping ENTIRE /proc/misc to kernel log:" > /dev/kmsg
cat /proc/misc > /dev/kmsg

echo "[*] Finding dynamic minor number..." > /dev/kmsg

# Try procfs first
MINOR=$(grep custom_kexec /proc/misc | awk '{print $1}')

# Try sysfs fallback
if [ -z "$MINOR" ] && [ -f "/sys/class/misc/custom_kexec/dev" ]; then
    MINOR=$(cat /sys/class/misc/custom_kexec/dev | cut -d: -f2)
    echo "[+] Discovered minor via sysfs: $MINOR" > /dev/kmsg
fi

echo "[*] Attempting to extract runtime kernel config..." > /dev/kmsg
if [ -f "/proc/config.gz" ]; then
    zcat /proc/config.gz > /dev/kmsg 2>&1 || gzip -dc /proc/config.gz > /dev/kmsg 2>&1
    echo "[+] SUCCESS: Dumped config.gz to kmsg!" > /dev/kmsg
else
    echo "[-] /proc/config.gz does not exist on this host." > /dev/kmsg
fi

echo "[*] Checking kexec symbols in the running kernel..." > /dev/kmsg
grep -i kexec_mod /proc/kallsyms > /dev/kmsg || echo "[-] No kexec_mod symbols found in kallsyms!" > /dev/kmsg

echo "[*] Checking if misc_register symbol is present in the host kernel..." > /dev/kmsg
grep -w misc_register /proc/kallsyms > /dev/kmsg || echo "[-] misc_register symbol is MISSING from this kernel!" > /dev/kmsg

if [ -z "$MINOR" ]; then
    echo "[-] CRITICAL ERROR: custom_kexec not registered in misc framework!" > /dev/kmsg
    echo "[-] Module likely failed to initialize or aborted early. Check dmesg output above." > /dev/kmsg
    while true; do sleep 1; done
fi

echo "[+] Found custom_kexec at minor number: $MINOR" > /dev/kmsg
echo "[*] Manually creating /dev/custom_kexec node..." > /dev/kmsg

# All misc devices use Major number 10. We use the extracted dynamic Minor number.
mknod /dev/custom_kexec c 10 $MINOR

echo "[*] Node created successfully. Triggering pivot..." > /dev/kmsg

# Execute the usermode loader, pushing all output to the kernel log so we see it in QEMU
/bin/custom_kexec > /dev/kmsg 2>&1
EXEC_RET=$?

# If custom_kexec fails or returns, catch it so PID 1 doesn't panic silently
echo "[-] ERROR: custom_kexec terminated unexpectedly with code: $EXEC_RET" > /dev/kmsg
while true; do sleep 1; done